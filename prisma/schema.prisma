datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(uuid())
  fullName       String
  displayName    String?
  email          String          @unique
  university     String?
  githubUsername String?
  createdAt      DateTime        @default(now())
  status         String          @default("ACTIVE") // "ACTIVE", "ARCHIVED", "DELETED_PERMANENTLY"
  deletedAt      DateTime?
  restorableUntil DateTime?
  githubAccount  GitHubAccount?
  reposAsMember  RepositoryMember[]
  createdTasks   Task[]          @relation("CreatedTasks")
  assignedTasks  Task[]          @relation("AssignedTasks")
  taskActivities TaskActivity[]
  taskComments   TaskComment[]
  contributionMetrics ContributionMetric[]
  otpSession     OTPSession?
}

model GitHubAccount {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken       String    // Encrypted token
  refreshToken      String?   // For OAuth refresh
  expiresAt         DateTime?
  username          String    // GitHub username
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model GitHubRepository {
  id                String             @id @default(uuid())
  githubId          String             @unique // GitHub's internal repository ID stored as string
  owner             String
  name              String
  description       String?
  url               String
  visibility        String             // "public" | "private"
  language          String?
  stars             Int                @default(0)
  forks             Int                @default(0)
  openIssues        Int                @default(0)
  branchesCount     Int                @default(1)
  lastCommitAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  // Realtime Sync telemetry
  lastSyncedAt      DateTime?
  webhookSecret     String?
  webhookActive     Boolean            @default(false)
  cicdPassRate      Float              @default(0.0) // CI/CD workflow pass rate percentage
  
  members           RepositoryMember[]
  commits           Commit[]
  pullRequests      PullRequest[]
  issues            Issue[]
  syncLogs          RepositorySyncLog[]
  analytics         ContributionAnalytics[]
  academicHubProjects AcademicHubProject[]
  tasks             Task[]
  contributionMetrics ContributionMetric[]
  commitTelemetries   CommitTelemetry[]
}

model RepositoryMember {
  id           String           @id @default(uuid())
  repoId       String
  repository   GitHubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?            @relation(fields: [userId], references: [id])
  gitUsername  String           // Collaborator's GitHub username
  gitAvatarUrl String?
  role         String           @default("contributor") // "lead" | "contributor"
  joinedAt     DateTime         @default(now())

  @@unique([repoId, gitUsername])
}

model Commit {
  id          String           @id @default(uuid())
  sha         String           @unique
  message     String
  authorName  String
  additions   Int              @default(0)
  deletions   Int              @default(0)
  authoredAt  DateTime
  repoId      String
  repository  GitHubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, authorName, authoredAt])
}

model PullRequest {
  id          String           @id @default(uuid())
  number      Int
  title       String
  state       String           // "open" | "closed" | "merged"
  authorName  String
  createdAt   DateTime
  closedAt    DateTime?
  mergedAt    DateTime?
  repoId      String
  repository  GitHubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, number])
  @@index([repoId, authorName, createdAt])
}

model Issue {
  id          String           @id @default(uuid())
  number      Int
  title       String
  state       String           // "open" | "closed"
  authorName  String
  createdAt   DateTime
  closedAt    DateTime?
  repoId      String
  repository  GitHubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, number])
  @@index([repoId, authorName, createdAt])
}

model RepositorySyncLog {
  id          String           @id @default(uuid())
  repoId      String
  repository  GitHubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  status      String           // "success" | "failed"
  message     String?
  trigger     String           // "manual" | "webhook" | "cron"
  rateLimit   Int?             // Remaining API requests
  syncedAt    DateTime         @default(now())
}

model ContributionAnalytics {
  id             String           @id @default(uuid())
  repoId         String
  repository     GitHubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  gitUsername    String
  commitSharePct Float            @default(0.0)
  codeChangePct  Float            @default(0.0)
  fairnessScore  Float            @default(100.0)
  burnoutIndex   Float            @default(0.0) // 0-100 load index
  activeDays     Int              @default(0)
  prMergeTimeAvg Float            @default(0.0) // Avg time to merge PRs in hours
  reviewQualityScore Float        @default(0.0) // Metric based on reviews given/received
  updatedAt      DateTime         @updatedAt

  @@unique([repoId, gitUsername])
}

model Task {
  id               String           @id @default(uuid())
  title            String
  description      String?
  priority         String           // "low" | "medium" | "high" | "urgent"
  status           String           // "backlog" | "todo" | "in_progress" | "review" | "completed"
  labels           String           @default("") // Comma-separated list of tags
  dueDate          DateTime?
  estimatedHours   Float            @default(0.0)
  githubIssueUrl   String?
  linkedPullRequest String?
  linkedCommitHash String?
  
  repositoryId     String?
  repository       GitHubRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  workspaceId      String?
  
  creatorId        String?
  creator          User?            @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: SetNull)
  assigneeId       String?
  assignee         User?            @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  completedAt      DateTime?

  activities       TaskActivity[]
  comments         TaskComment[]
  attachments      TaskAttachment[]
  telemetry        TaskTelemetry[]

  @@index([workspaceId, assigneeId, status])
  @@index([dueDate])
}

model TaskActivity {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actionType  String   // "create" | "status_change" | "assignee_change" | "comment" | "github_link"
  metadata    String?  // Brief action info
  createdAt   DateTime @default(now())
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  content   String
  createdAt DateTime @default(now())
}

model TaskAttachment {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileType    String
  uploadedBy  String?
  createdAt   DateTime @default(now())
}

model TaskTelemetry {
  id                String   @id @default(uuid())
  taskId            String
  task              Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commitCount       Int      @default(0)
  pullRequestCount  Int      @default(0)
  linesChanged      Int      @default(0)
  contributionScore Float    @default(0.0)
  syncedAt          DateTime @default(now())
}

model ContributionMetric {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId       String
  repositoryId      String?
  repository        GitHubRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  commits           Int               @default(0)
  pullRequests      Int               @default(0)
  issuesClosed      Int               @default(0)
  reviewsGiven      Int               @default(0)
  linesAdded        Int               @default(0)
  linesDeleted      Int               @default(0)
  activeHours       Float             @default(0.0)
  contributionScore Float             @default(0.0)
  calculatedAt      DateTime          @default(now())

  @@unique([userId, workspaceId, repositoryId])
}

model CommitTelemetry {
  id            String            @id @default(uuid())
  commitHash    String            @unique
  repositoryId  String
  repository    GitHubRepository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  authorId      String?
  branch        String            @default("main")
  additions     Int               @default(0)
  deletions     Int               @default(0)
  filesChanged  Int               @default(0)
  commitMessage String
  committedAt   DateTime
}

model ProductivitySnapshot {
  id               String   @id @default(uuid())
  workspaceId      String
  sprintName       String
  completedTasks   Int      @default(0)
  overdueTasks     Int      @default(0)
  velocity         Float    @default(0.0)
  workloadBalance  Float    @default(0.0)
  generatedAt      DateTime @default(now())

  @@unique([workspaceId, sprintName])
}

model Sprint {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())

  @@unique([workspaceId, name])
}

model MeetingInsight {
  id                   String   @id @default(uuid())
  meetingId            String   @unique
  participationRate    Float    @default(0.0)
  speakingTime         Float    @default(0.0)
  actionItemsAssigned  Int      @default(0)
  attendanceScore      Float    @default(0.0)
  createdAt            DateTime @default(now())
}

// ─────────────────────────────────────────────
// MEETING MANAGEMENT SYSTEM
// ─────────────────────────────────────────────

model Meeting {
  id             String   @id @default(uuid())
  workspaceId    String
  creatorId      String?
  title          String
  description    String?
  platform       String   @default("meet") // "meet" | "zoom" | "teams" | "other"
  meetingLink    String?
  scheduledDate  String   // ISO date string YYYY-MM-DD
  startTime      String   // HH:MM 24h
  endTime        String   // HH:MM 24h
  timezone       String   @default("Asia/Kolkata")
  recurring      Boolean  @default(false)
  recurrenceRule String?  // "daily" | "weekly" | "monthly"
  status         String   @default("upcoming") // "upcoming" | "live" | "completed" | "cancelled"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participants   MeetingParticipant[]
  agenda         MeetingAgenda[]
  notes          MeetingNote[]
  reminders      MeetingReminder[]
}

model MeetingParticipant {
  id               String    @id @default(uuid())
  meetingId        String
  meeting          Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId           String?
  userEmail        String?
  userFullName     String?
  role             String    @default("participant") // "host" | "participant"
  attendanceStatus String    @default("pending")    // "pending" | "accepted" | "declined" | "attended"
  joinedAt         DateTime?
  createdAt        DateTime  @default(now())

  @@unique([meetingId, userId])
}

model MeetingAgenda {
  id          String   @id @default(uuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title       String
  description String?
  completed   Boolean  @default(false)
  taskId      String?  // optional link to a Task
  createdBy   String?
  createdAt   DateTime @default(now())
}

model MeetingNote {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content   String
  authorId  String?
  authorName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeetingReminder {
  id           String   @id @default(uuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  reminderType String   @default("in_app") // "in_app" | "email" | "calendar"
  minutesBefore Int     @default(15)       // 15 | 30 | 60
  sent         Boolean  @default(false)
  failed       Boolean  @default(false)
  scheduledAt  DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────
// WORKFORCE & TEAM INTELLIGENCE SYSTEM
// ─────────────────────────────────────────────

model Workspace {
  id                  String            @id @default(uuid())
  name                String
  ownerId             String
  inviteCode          String            @unique
  inviteCodeUpdatedAt DateTime          @default(now())
  createdAt           DateTime          @default(now())

  members    WorkspaceMember[]
  activities TeamActivity[]
  presences  MemberPresence[]
  contributions ContributionSummary[]
  academicHubProjects AcademicHubProject[]
}

model WorkspaceMember {
  id                String    @id @default(uuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId            String
  role              String    @default("Contributor") // "Owner" | "Admin" | "Contributor" | "Viewer"
  joinedAt          DateTime  @default(now())
  githubUsername    String?
  avatarUrl         String?
  contributionScore Float     @default(0.0)
  activityStatus    String    @default("offline")    // "online" | "offline" | "idle"

  @@unique([workspaceId, userId])
}

model TeamActivity {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  userFullName String    @default("Contributor")
  activityType String    // "commit" | "pr" | "task_completed" | "meeting_attended" | "join" | "role_change"
  metadata     String?   // Detailed activity summary text
  createdAt    DateTime  @default(now())
}

model MemberPresence {
  id               String    @id @default(uuid())
  userId           String
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  onlineStatus     String    @default("offline")    // "online" | "offline" | "idle"
  lastSeen         DateTime  @default(now())
  activeRepository String?
  activeTask       String?

  @@unique([workspaceId, userId])
}

model ContributionSummary {
  id                String    @id @default(uuid())
  userId            String
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  commits           Int       @default(0)
  pullRequests      Int       @default(0)
  reviews           Int       @default(0)
  tasksCompleted    Int       @default(0)
  meetingsAttended  Int       @default(0)
  contributionScore Float     @default(0.0)
  updatedAt         DateTime  @updatedAt

  @@unique([workspaceId, userId])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS & PUSH SUBSCRIPTION SYSTEMS
// ─────────────────────────────────────────────

model Notification {
  id           String             @id @default(uuid())
  workspaceId  String
  senderId     String?
  receiverId   String
  type         String             // "task" | "github" | "meeting" | "system" | "invite" | "mention" | "report"
  title        String
  message      String
  isRead       Boolean            @default(false)
  priority     String             // "low" | "medium" | "high" | "urgent"
  actionUrl    String?
  createdAt    DateTime           @default(now())

  replies      NotificationReply[]
}

model NotificationReply {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  senderId       String
  senderName     String
  receiverId     String
  message        String
  createdAt      DateTime     @default(now())
}

model NotificationPreference {
  id                 String  @id @default(uuid())
  userId             String  @unique
  browserEnabled     Boolean @default(true)
  mobileEnabled      Boolean @default(true)
  emailEnabled       Boolean @default(true)
  meetingAlerts      Boolean @default(true)
  taskAlerts         Boolean @default(true)
  contributionAlerts Boolean @default(true)
  teammateMentions   Boolean @default(true)
}

model PushSubscriptionModel {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  deviceType String   @default("desktop") // "desktop" | "mobile" | "tablet"
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────
// CERTIFIED REPORTS SYSTEM
// ─────────────────────────────────────────────

model Report {
  id          String   @id @default(uuid())
  workspaceId String
  generatedBy String
  type        String   // "contribution" | "sprint" | "repository" | "productivity" | "meeting" | "fairness" | "evaluation" | "activity"
  reportUrl   String
  createdAt   DateTime @default(now())
}

model ContributionReport {
  id                   String   @id @default(uuid())
  workspaceId          String
  userId               String
  commits              Int      @default(0)
  pullRequests         Int      @default(0)
  tasksCompleted       Int      @default(0)
  meetingParticipation Float    @default(0.0)
  contributionScore    Float    @default(0.0)
  fairnessScore        Float    @default(100.0)
  generatedAt          DateTime @default(now())
}

model SprintReport {
  id                String   @id @default(uuid())
  workspaceId       String
  sprintName        String
  completedTasks    Int      @default(0)
  overdueTasks      Int      @default(0)
  productivityScore Float    @default(0.0)
  generatedAt       DateTime @default(now())
}

model MeetingReport {
  id                    String   @id @default(uuid())
  workspaceId           String
  attendanceRate        Float    @default(0.0)
  actionItemsCompleted  Int      @default(0)
  generatedAt           DateTime @default(now())
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  fullName          String
  displayName       String?
  email             String   @unique
  phoneNumber       String?
  university        String?
  degree            String?
  userType          String?  // e.g. "Student" | "Developer" | "Professor"
  roleInContriTrack String?  // e.g. "Lead" | "Contributor"
  bio               String?
  avatarUrl         String?
  githubUsername    String?
  linkedinUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserSecurity {
  id                String    @id @default(uuid())
  userId            String    @unique
  twoFactorEnabled  Boolean   @default(false)
  recoveryEmail     String?
  verifiedPhone     String?
  passwordChangedAt DateTime?
  lastLogin         DateTime?
  activeSessions    String?   // JSON-serialized string of device arrays
  failedAttempts    Int       @default(0)
}

model UserBackup {
  id            String   @id @default(uuid())
  userId        String
  backupDataUrl String   // Serialized encrypted JSON payload
  backupType    String   // "full" | "settings"
  createdAt     DateTime @default(now())
  expiresAt     DateTime
}

model UserActivity {
  id           String   @id @default(uuid())
  userId       String
  activityType String   // "login" | "backup" | "restore" | "delete_attempt" | "settings_update" | "password_change"
  ipAddress    String?
  device       String?
  browser      String?
  location     String?
  createdAt    DateTime @default(now())
}

model DeletedAccountArchive {
  id                 String   @id @default(uuid())
  originalUserId     String   @unique
  userEmail          String   @unique @default("recovery@teamtrace.com")
  encryptedBackupUrl String   // Archived data snapshot
  deletedAt          DateTime @default(now())
  recoverableUntil   DateTime
}

model AIInsight {
  id              String   @id @default(uuid())
  workspaceId     String
  userId          String
  insightType     String   // "burnout" | "parity" | "freerider" | "recommendation"
  severity        String   // "critical" | "warning" | "info"
  title           String
  description     String
  confidenceScore Float    @default(0.0)
  createdAt       DateTime @default(now())
}

model UserContributionAnalytics {
  id                   String   @id @default(uuid())
  userId               String   @unique
  commits              Int      @default(0)
  pullRequests         Int      @default(0)
  issuesClosed         Int      @default(0)
  taskCompletionRate   Float    @default(0.0)
  meetingAttendance    Float    @default(0.0)
  collaborationScore   Float    @default(0.0)
  workloadScore        Float    @default(0.0)
  burnoutScore         Float    @default(0.0)
  inactivityScore      Float    @default(0.0)
  updatedAt            DateTime @updatedAt
}

model BurnoutSignal {
  id                 String   @id @default(uuid())
  userId             String
  stressLevel        Float    @default(0.0)
  overtimeDetected   Boolean  @default(false)
  inactivityDetected Boolean  @default(false)
  missedDeadlines    Int      @default(0)
  taskOverflow       Int      @default(0)
  createdAt          DateTime @default(now())
}

model ProductivityForecast {
  id                  String   @id @default(uuid())
  workspaceId         String   @unique
  sprintVelocity      Float    @default(0.0)
  predictedCompletion Float    @default(0.0)
  estimatedDelays     String?  // JSON-serialized array of delayed members
  aiRecommendations   String?  // JSON-serialized recommendations
  updatedAt           DateTime @updatedAt
}

model TeamParityAnalysis {
  id                     String   @id @default(uuid())
  workspaceId            String   @unique
  overloadedMembers      String?  // JSON-serialized members
  underperformingMembers String?  // JSON-serialized members
  freeRiderFlags         String?  // JSON-serialized members
  workloadBalanceScore   Float    @default(100.0)
  updatedAt              DateTime @updatedAt
}

model ApiKey {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  name        String
  hashedKey   String   @unique
  previewKey  String
  permissions String[]
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  revoked     Boolean  @default(false)
}

model JobRole {
  id                      String   @id @default(uuid())
  slug                    String   @unique
  title                   String
  department              String
  level                   String   @default("fresher")
  location                String   @default("Remote")
  remoteType              String   @default("Full-Time")
  salaryMin               Int      @default(0)
  salaryMax               Int      @default(0)
  description             String
  fresherRequirements     String
  experiencedRequirements String
  technologies            String[]
  status                  String   @default("open")
  createdAt               DateTime @default(now())
}

model ApplicationDraft {
  id          String   @id @default(uuid())
  userId      String?
  roleId      String
  fullName    String
  email       String
  progress    Float    @default(0.0)
  resumeUrl   String?
  portfolio   String?
  github      String?
  linkedin    String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
}

model JobApplication {
  id              String   @id @default(uuid())
  roleId          String
  roleTitle       String
  fullName        String
  email           String
  phone           String
  country         String
  university      String
  degree          String
  gradYear        String
  experienceLevel String
  github          String?
  linkedin        String?
  portfolio       String?
  resumeUrl       String
  whyJoin         String
  bestProject     String
  techStrengths   String
  collabExp       String
  availability    String
  status          String   @default("pending")
  notes           String?
  interviewLink   String?
  interviewDate   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OTPSession {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedOtp String
  phone     String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model AcademicHub {
  id             String               @id @default(uuid())
  slug           String               @unique // "capstone" | "open-source" | "ai-research" | "hackathon" | "faculty-oversight"
  name           String
  type           String               // "capstone" | "open_source" | "ai_research" | "hackathon" | "faculty_oversight"
  institution    String               @default("Global University Network")
  description    String
  icon           String               @default("GraduationCap")
  bannerGradient String               @default("from-[#CD9FA0]/20 to-[#F2C1A3]/10")
  members        AcademicHubMember[]
  projects       AcademicHubProject[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model AcademicHubMember {
  id        String      @id @default(uuid())
  hubId     String
  hub       AcademicHub @relation(fields: [hubId], references: [id], onDelete: Cascade)
  userId    String
  role      String      @default("STUDENT") // "STUDENT" | "PROFESSOR" | "MENTOR" | "ADMIN"
  joinedAt  DateTime    @default(now())

  @@unique([hubId, userId])
}

model AcademicHubProject {
  id           String           @id @default(uuid())
  hubId        String
  hub          AcademicHub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  workspaceId  String?
  workspace    Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  repositoryId String?
  repository   GitHubRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  projectName  String
  description  String?
  linkedAt     DateTime         @default(now())
}



